# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Public URL for the official Ramblings & Epiphanies WhatsApp Channel
VITE_WHATSAPP_CHANNEL_URL="https://chat.whatsapp.com/YOUR_INVITE_LINK_HERE"

# Supabase Public Configuration
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Paystack Public Configuration (Frontend)
VITE_PAYSTACK_PUBLIC_KEY="pk_test_your_public_key"

# ---------------------------------------------------------
# SERVER-SIDE ONLY VARIABLES (NEVER prefix with VITE_)
# ---------------------------------------------------------

# Supabase Admin Access (Service Role)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Paystack Secret (Backend Webhook Verification)
PAYSTACK_SECRET_KEY="sk_test_your_secret_key"

# Email Configuration (Resend)
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM_EMAIL="Ramblings & Epiphanies <orders@yourdomain.com>"

# Release Automation
RELEASE_DATE="2024-12-01"
CRON_SECRET="your_vercel_cron_secret"

